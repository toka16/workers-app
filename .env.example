# --- Supabase -------------------------------------------------------------
# Local values are printed by `pnpm supabase status`. For production use the
# project's URL and publishable (anon) key from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Optional: URL the *server* uses to reach Supabase when it differs from the browser URL
# (docker-compose sets this to http://host.docker.internal:54321).
# SUPABASE_INTERNAL_URL=

# --- App ------------------------------------------------------------------
# Public origin, used for auth e-mail links, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Providers (repository implementations) --------------------------------
# Each capability can come from a different provider. Available: supabase, memory.
NEXT_PUBLIC_AUTH_PROVIDER=supabase
NEXT_PUBLIC_DB_PROVIDER=supabase
NEXT_PUBLIC_STORAGE_PROVIDER=supabase
